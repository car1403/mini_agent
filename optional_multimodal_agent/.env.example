# 실행 모드: 이 프로젝트는 real + postgres만 허용
APP_MODE=real
LLM_PROVIDER=openai
STORAGE_MODE=postgres

# LLM 호출 실패 시 다른 실제 Provider를 사용할지 여부
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=openai

# OpenAI: 일반 LLM, 이미지 분석, TTS에 사용
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
MAX_IMAGE_SIZE_MB=5

# Gemini를 선택할 때 두 값을 모두 설정
GEMINI_API_KEY=
GEMINI_MODEL=

# 로컬 Ollama를 선택할 때 사용
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
REQUEST_TIMEOUT_SECONDS=30

# Streamlit Frontend가 호출할 Backend 주소
PYTHON_AGENT_API_URL=http://127.0.0.1:8000
LANGGRAPH_AGENT_API_URL=http://127.0.0.1:8001

# Backend가 MCP Tool Server를 호출할 때 사용
TOOLS_MCP_URL=http://127.0.0.1:8020/mcp

# MCP Tool Server가 수신할 주소와 포트
MCP_HOST=127.0.0.1
MCP_PORT=8020

# PostgreSQL Docker 컨테이너(aidevs-pgvector)의 호스트 연결 주소
DATABASE_URL=postgresql://agent_user:agent_password@127.0.0.1:5433/agent_db
